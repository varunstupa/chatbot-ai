# Copy to .env and fill in. .env is git- and docker-ignored; never commit real values.

# --- Admin-app chat (/app-chat) ---
# Shared with the API gateway (same value as its CHATBOT_INTERNAL_SECRET).
# Required when auth.mode is "gateway" (production config); otherwise /app-chat returns 503.
CHATBOT_INTERNAL_SECRET=
# Required by the guide listing and /upload (header X-Service-Key).
KNOWLEDGE_SERVICE_KEY=
# Only for auth.mode "jwt" (browser calls the chatbot directly). Set one of:
#   APP_CHAT_JWT_PUBLIC_KEY  PEM public key of the user-role service (RS256)
#   APP_CHAT_JWT_SECRET      shared secret (HS256)
APP_CHAT_JWT_PUBLIC_KEY=
APP_CHAT_JWT_SECRET=
# Local development only: accepts login tokens without checking the signature.
# Never set this on a shared or production server.
# APP_CHAT_ALLOW_UNVERIFIED_DEV_TOKENS=true


# --- Jira ticketing (optional; without it tickets report "not configured") ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=
JIRA_ISSUE_TYPE_ID=

# --- docker compose ---
# Host port for the backend; use 8001 when the API gateway already uses 8000.
# CHATBOT_HOST_PORT=8000

# MongoDB for the chat store (questions/answers per tenant and session).
# Optional: defaults to chat_store.mongodb_uri in config.yaml.
CHAT_STORE_MONGODB_URI=
